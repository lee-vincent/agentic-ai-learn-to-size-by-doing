# monitoring/.env.example
#
# Copy to `.env` in this directory (`cp .env.example .env`) and edit before
# `docker compose up -d`. Every value has a safe default baked into docker-compose.yml, so an
# empty/missing .env still works -- this file exists for the values you actually want to change
# (the admin password, above all) and to pin image tags explicitly if you want a different,
# verified-good version than the one baked in as the compose-file default.

# Grafana admin login (also reachable as an anonymous read-only Viewer -- see docker-compose.yml).
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=gpusizinglab

# Pinned image tags -- verified to exist on their respective registries at build time. Override
# only after checking the new tag actually exists (no :latest anywhere in this stack).
PROMETHEUS_IMAGE_TAG=v3.13.1
GRAFANA_IMAGE_TAG=13.1.1
NODE_EXPORTER_IMAGE_TAG=v1.12.1
DCGM_EXPORTER_IMAGE_TAG=4.5.2-4.8.1-ubuntu22.04
